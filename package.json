{
  "name": "karaoke-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Вертикальные караоке-видео из аудио и синхронизированного текста",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "NODE_USE_ENV_PROXY=1 node server.js",
    "dev": "NODE_USE_ENV_PROXY=1 node --watch server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "build:pages": "node scripts/build-pages.mjs",
    "setup:ai": "bash scripts/install-ai.sh"
  }
}
